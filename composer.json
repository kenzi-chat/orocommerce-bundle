{
    "name": "kenzi/kenzi-orocommerce-bundle",
    "description": "Connect your OroCommerce store to Kenzi for customer messaging powered by real-time order and customer data.",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://kenzi.chat/integrations/orocommerce",
    "authors": [
        {
            "name": "Kenzi",
            "homepage": "https://kenzi.chat"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/framework-bundle": "~6.4.0 || ~7.4.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.65",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Kenzi\\OroCommerceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kenzi\\OroCommerceBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist"
    },
    "scripts": {
        "lint": "php-cs-fixer fix --dry-run --diff",
        "lint:fix": "php-cs-fixer fix",
        "analyze": "phpstan analyse",
        "test": "phpunit"
    }
}
